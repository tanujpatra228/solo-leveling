{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["./worker-configuration.d.ts"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo"
  },
  "include": ["worker", "worker-configuration.d.ts"],
  // Tests are typechecked by tsconfig.test.json instead. The cross-check test
  // imports the client copy of the decoder, and a file cannot belong to two
  // composite projects at once.
  "exclude": ["worker/**/*.test.ts"]
}
